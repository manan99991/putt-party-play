require 'spaceship'
require 'shellwords'

default_platform(:ios)

# bundle id => Xcode target name
TARGETS = {
  "com.tenzy.toolkit"          => "HandyTools",
  "com.tenzy.toolkit.keyboard" => "ClipboardKeyboard",
  "com.tenzy.toolkit.share"    => "ShareExtension",
  "com.tenzy.toolkit.widget"   => "StickyWidget",
}.freeze
BUNDLE_IDS = TARGETS.keys.freeze

platform :ios do
  # Build + sign + upload to TestFlight using an App Store Connect API key.
  # Fastlane authenticates to the App Store Connect API (which the key works for), creates the
  # distribution cert + App Store profiles itself, and signs manually — avoiding xcodebuild's
  # cloud-signing path, which rejects the API token.
  lane :beta do
    key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )

    # Direct ConnectAPI token for the bits the fastlane actions don't cover.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      filepath: ENV["ASC_KEY_PATH"]
    )

    # Ensure every bundle id exists as an App ID (extensions are created here; the user then
    # enables the App Group on them in the Developer portal — the one thing the API can't do).
    existing = Spaceship::ConnectAPI::BundleId.all.map(&:identifier)
    BUNDLE_IDS.each do |bid|
      next if existing.include?(bid)
      UI.message("Creating App ID #{bid}")
      Spaceship::ConnectAPI::BundleId.create(name: "Tenzy #{bid.split('.').last}", identifier: bid, platform: "IOS")
    end

    # Free Tenzy's distribution-cert slot: revoke the cert our previous run created (id passed in
    # via TENZY_PREV_CERT_ID) so we stay under Apple's 2-cert cap. Only ever Tenzy's own id — other
    # apps' certs (e.g. Reckato) are never touched.
    keychain_name = "tenzyci"
    keychain_pw = "tenzyci-pw"
    create_keychain(
      name: keychain_name, password: keychain_pw,
      default_keychain: true, unlock: true, timeout: 3600, lock_when_sleeps: false
    )
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    # Reuse one distribution cert across runs. The .p12 lives in the repo's private Actions cache
    # (ios/cert-cache). When present we just import it — no revoke, no new cert, so no "certificate
    # revoked" emails. Only when the cache is empty do we fall back to creating one.
    cached_p12 = File.expand_path("cert-cache/dist.p12")
    p12_pw = "tenzyci-p12"
    reused = false
    if File.exist?(cached_p12)
      begin
        import_certificate(
          certificate_path: cached_p12,
          certificate_password: p12_pw,
          keychain_name: keychain_name,
          keychain_password: keychain_pw
        )
        UI.message("Reusing cached distribution certificate — no revoke, no new cert")
        reused = true
      rescue => e
        UI.important("Cached cert import failed; creating a fresh one: #{e}")
      end
    end

    unless reused
      # First run (or cache miss): stay under Apple's 2-cert cap by revoking every distribution
      # cert except the keep-list (Reckato's), then create a fresh one and cache it.
      keep = (ENV["KEEP_CERT_IDS"] || "24QVV6RW8U").split(",").map(&:strip)
      begin
        Spaceship::ConnectAPI::Certificate.all.each do |c|
          next unless c.certificate_type.to_s.include?("DISTRIBUTION")
          next if keep.include?(c.id)
          Spaceship::ConnectAPI.delete_certificate(certificate_id: c.id)
          UI.message("Revoked distribution cert #{c.id}")
        end
      rescue => e
        UI.important("Cert cleanup issue: #{e}")
      end
      cert(api_key: key, keychain_path: keychain_path, keychain_password: keychain_pw, output_path: "build/certs")
      # Export the identity (cert + private key) into the cache for future runs to reuse.
      begin
        sh("mkdir -p cert-cache")
        sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{keychain_pw} #{keychain_path.shellescape} >/dev/null 2>&1 || true")
        sh("security export -k #{keychain_path.shellescape} -t identities -f pkcs12 -P #{p12_pw} -o #{cached_p12.shellescape}")
        UI.message("Cached distribution identity for reuse")
      rescue => e
        UI.important("Cert caching failed (non-fatal — will create again next run): #{e}")
      end
    end

    # One App Store provisioning profile per target.
    profiles = {}
    BUNDLE_IDS.each do |bid|
      sigh(api_key: key, app_identifier: bid, platform: "ios", output_path: "build/profiles", force: true)
      profiles[bid] = lane_context[SharedValues::SIGH_NAME]
    end
    UI.message("Provisioning profiles: #{profiles}")

    # Manual signing per target so the archive uses our profiles, not xcodebuild cloud signing.
    TARGETS.each do |bid, target|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "HandyTools.xcodeproj",
        team_id: ENV["TEAM_ID"],
        targets: [target],
        bundle_identifier: bid,
        code_sign_identity: "Apple Distribution",
        profile_name: profiles[bid]
      )
    end

    # Build number (CFBundleVersion) is baked at project-generation time in CI as a Unix timestamp,
    # so every upload is unique and ever-increasing.
    build_app(
      project: "HandyTools.xcodeproj",
      scheme: "HandyTools",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Tenzy.ipa",
      export_options: {
        teamID: ENV["TEAM_ID"],
        signingStyle: "manual",
        provisioningProfiles: profiles
      }
    )

    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  # Creates/updates the auto-renewing subscriptions and their prices directly through the
  # App Store Connect API, so the monthly plan + both prices are set by the pipeline, not by hand.
  # Idempotent: safe to re-run. Run via the "iOS Subscriptions" workflow (workflow_dispatch).
  lane :subscriptions do
    require 'net/http'
    require 'json'
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    base = "https://api.appstoreconnect.apple.com"
    http = Net::HTTP.new("api.appstoreconnect.apple.com", 443); http.use_ssl = true
    req = lambda do |method, path, body = nil|
      klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch }[method]
      r = klass.new(URI(base + path))
      r["Authorization"] = "Bearer #{token.text}"
      r["Content-Type"] = "application/json"
      r.body = body.to_json if body
      res = http.request(r)
      parsed = (JSON.parse(res.body) rescue res.body)
      [res.code.to_i, parsed]
    end

    code, data = req.call(:get, "/v1/apps?filter%5BbundleId%5D=com.tenzy.toolkit&limit=1")
    app_id = data.is_a?(Hash) ? data.dig("data", 0, "id") : nil
    UI.user_error!("App not found (#{code}): #{data}") unless app_id
    UI.message("App #{app_id}")

    code, data = req.call(:get, "/v1/apps/#{app_id}/subscriptionGroups?limit=50")
    group = (data["data"] || []).find { |g| g.dig("attributes", "referenceName") == "Tenzy Pro" }
    unless group
      code, data = req.call(:post, "/v1/subscriptionGroups",
        { data: { type: "subscriptionGroups", attributes: { referenceName: "Tenzy Pro" },
                  relationships: { app: { data: { type: "apps", id: app_id } } } } })
      group = data["data"]
      UI.message("Created group (#{code})")
    end
    group_id = group["id"]

    code, data = req.call(:get, "/v1/subscriptionGroups/#{group_id}/subscriptions?limit=50")
    existing = data["data"] || []

    want = [
      { pid: "tenzy_pro_yearly",  name: "Tenzy Pro (Yearly)",  period: "ONE_YEAR",  usd: "19.99" },
      { pid: "tenzy_pro_monthly", name: "Tenzy Pro (Monthly)", period: "ONE_MONTH", usd: "2.99" },
    ]
    want.each do |w|
      sub = existing.find { |s| s.dig("attributes", "productId") == w[:pid] }
      unless sub
        code, data = req.call(:post, "/v1/subscriptions",
          { data: { type: "subscriptions",
                    attributes: { name: w[:name], productId: w[:pid], subscriptionPeriod: w[:period], familySharable: false },
                    relationships: { group: { data: { type: "subscriptionGroups", id: group_id } } } } })
        sub = data["data"]
        UI.message("Create #{w[:pid]} -> #{code}#{code >= 400 ? " #{data}" : ""}")
      else
        UI.message("#{w[:pid]} exists (#{sub['id']})")
      end
      next unless sub
      sub_id = sub["id"]

      code, locs = req.call(:get, "/v1/subscriptions/#{sub_id}/subscriptionLocalizations?limit=50")
      unless (locs["data"] || []).any? { |l| l.dig("attributes", "locale") == "en-US" }
        code, data = req.call(:post, "/v1/subscriptionLocalizations",
          { data: { type: "subscriptionLocalizations",
                    attributes: { locale: "en-US", name: w[:name], description: "Everything in Tenzy, unlimited. No ads." },
                    relationships: { subscription: { data: { type: "subscriptions", id: sub_id } } } } })
        UI.message("  localization -> #{code}")
      end

      code, pp = req.call(:get, "/v1/subscriptions/#{sub_id}/pricePoints?filter%5Bterritory%5D=USA&limit=200")
      points = pp["data"] || []
      target = points.min_by { |p| (p.dig("attributes", "customerPrice").to_f - w[:usd].to_f).abs } if points.any?
      if target
        code, data = req.call(:post, "/v1/subscriptionPrices",
          { data: { type: "subscriptionPrices", attributes: { preserveCurrentPrice: false },
                    relationships: { subscription: { data: { type: "subscriptions", id: sub_id } },
                                     subscriptionPricePoint: { data: { type: "subscriptionPricePoints", id: target["id"] } } } } })
        UI.success("  price -> #{code} near $#{w[:usd]} (#{target.dig('attributes', 'customerPrice')})#{code >= 400 ? " #{data}" : ""}")
      else
        UI.important("  no USD price points returned (#{code})")
      end
    end
    UI.success("Subscriptions reconciled.")
  end
end
