require 'spaceship'
require 'shellwords'

default_platform(:ios)

# bundle id => Xcode target name
TARGETS = {
  "com.tenzy.toolkit"          => "HandyTools",
  "com.tenzy.toolkit.keyboard" => "ClipboardKeyboard",
  "com.tenzy.toolkit.share"    => "ShareExtension",
  "com.tenzy.toolkit.widget"   => "StickyWidget",
}.freeze
BUNDLE_IDS = TARGETS.keys.freeze

platform :ios do
  # Build + sign + upload to TestFlight using an App Store Connect API key.
  # Fastlane authenticates to the App Store Connect API (which the key works for), creates the
  # distribution cert + App Store profiles itself, and signs manually — avoiding xcodebuild's
  # cloud-signing path, which rejects the API token.
  lane :beta do
    key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false
    )

    # Direct ConnectAPI token for the bits the fastlane actions don't cover.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      filepath: ENV["ASC_KEY_PATH"]
    )

    # Ensure every bundle id exists as an App ID (extensions are created here; the user then
    # enables the App Group on them in the Developer portal — the one thing the API can't do).
    existing = Spaceship::ConnectAPI::BundleId.all.map(&:identifier)
    BUNDLE_IDS.each do |bid|
      next if existing.include?(bid)
      UI.message("Creating App ID #{bid}")
      Spaceship::ConnectAPI::BundleId.create(name: "Tenzy #{bid.split('.').last}", identifier: bid, platform: "IOS")
    end

    # Signing now uses ONE shared Apple Distribution certificate for the whole account (the same cert
    # Reckato uses). It is supplied as a base64 secret (IOS_DIST_P12_B64), written to ios/dist.p12 by
    # CI, and only ever IMPORTED here. This lane never creates or revokes a certificate — removing
    # that is what ends the "certificate revoked" email storm between the two apps.
    keychain_name = "tenzyci"
    keychain_pw = "tenzyci-pw"
    create_keychain(
      name: keychain_name, password: keychain_pw,
      default_keychain: true, unlock: true, timeout: 3600, lock_when_sleeps: false
    )
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    # Anchor to the Fastfile's own location (ios/fastlane) so the path is correct no matter what
    # working directory fastlane evaluates from. CI also exports P12_PATH as an absolute override.
    p12_path = ENV["P12_PATH"] || File.expand_path("../dist.p12", __dir__)
    UI.message("Shared cert expected at #{p12_path} (pwd #{Dir.pwd})")
    UI.user_error!("Shared cert missing: write ios/dist.p12 from the IOS_DIST_P12_B64 secret before this lane") unless File.exist?(p12_path)
    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV["P12_PASSWORD"] || "tenzyshared",
      keychain_name: keychain_name,
      keychain_password: keychain_pw
    )
    UI.message("Imported shared distribution certificate — no create, no revoke")

    # One App Store provisioning profile per target.
    profiles = {}
    BUNDLE_IDS.each do |bid|
      sigh(api_key: key, app_identifier: bid, platform: "ios", output_path: "build/profiles", force: true)
      profiles[bid] = lane_context[SharedValues::SIGH_NAME]
    end
    UI.message("Provisioning profiles: #{profiles}")

    # Manual signing per target so the archive uses our profiles, not xcodebuild cloud signing.
    TARGETS.each do |bid, target|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "HandyTools.xcodeproj",
        team_id: ENV["TEAM_ID"],
        targets: [target],
        bundle_identifier: bid,
        code_sign_identity: "Apple Distribution",
        profile_name: profiles[bid]
      )
    end

    # Build number (CFBundleVersion) is baked at project-generation time in CI as a Unix timestamp,
    # so every upload is unique and ever-increasing.
    build_app(
      project: "HandyTools.xcodeproj",
      scheme: "HandyTools",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Tenzy.ipa",
      export_options: {
        teamID: ENV["TEAM_ID"],
        signingStyle: "manual",
        provisioningProfiles: profiles
      }
    )

    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  # Creates/updates the single auto-renewing Yearly subscription and its price directly through the
  # App Store Connect API, so the plan + price are set by the pipeline, not by hand.
  # Idempotent: safe to re-run. Run via the "iOS Subscriptions" workflow (workflow_dispatch).
  lane :subscriptions do
    require 'net/http'
    require 'json'
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], filepath: ENV["ASC_KEY_PATH"]
    )
    base = "https://api.appstoreconnect.apple.com"
    http = Net::HTTP.new("api.appstoreconnect.apple.com", 443); http.use_ssl = true
    req = lambda do |method, path, body = nil|
      klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch }[method]
      r = klass.new(URI(base + path))
      r["Authorization"] = "Bearer #{token.text}"
      r["Content-Type"] = "application/json"
      r.body = body.to_json if body
      res = http.request(r)
      parsed = (JSON.parse(res.body) rescue res.body)
      [res.code.to_i, parsed]
    end

    code, data = req.call(:get, "/v1/apps?filter%5BbundleId%5D=com.tenzy.toolkit&limit=1")
    app_id = data.is_a?(Hash) ? data.dig("data", 0, "id") : nil
    UI.user_error!("App not found (#{code}): #{data}") unless app_id
    UI.message("App #{app_id}")

    code, data = req.call(:get, "/v1/apps/#{app_id}/subscriptionGroups?limit=50")
    group = (data["data"] || []).find { |g| g.dig("attributes", "referenceName") == "Tenzy Pro" }
    unless group
      code, data = req.call(:post, "/v1/subscriptionGroups",
        { data: { type: "subscriptionGroups", attributes: { referenceName: "Tenzy Pro" },
                  relationships: { app: { data: { type: "apps", id: app_id } } } } })
      group = data["data"]
      UI.message("Created group (#{code})")
    end
    group_id = group["id"]

    code, data = req.call(:get, "/v1/subscriptionGroups/#{group_id}/subscriptions?limit=50")
    existing = data["data"] || []

    # All App Store territories (needed to make a subscription available for pricing).
    all_territories = []
    nextp = "/v1/territories?limit=200"
    while nextp
      code, tdata = req.call(:get, nextp)
      all_territories += (tdata["data"] || []).map { |t| { type: "territories", id: t["id"] } }
      link = tdata.dig("links", "next")
      nextp = link ? link.sub(base, "") : nil
    end
    UI.message("Territories: #{all_territories.size}")

    want = [
      { pid: "tenzy_pro_yearly",  name: "Tenzy Pro (Yearly)",  period: "ONE_YEAR",  usd: "19.99" },
    ]
    want.each do |w|
      sub = existing.find { |s| s.dig("attributes", "productId") == w[:pid] }
      unless sub
        code, data = req.call(:post, "/v1/subscriptions",
          { data: { type: "subscriptions",
                    attributes: { name: w[:name], productId: w[:pid], subscriptionPeriod: w[:period], familySharable: false },
                    relationships: { group: { data: { type: "subscriptionGroups", id: group_id } } } } })
        sub = data["data"]
        UI.message("Create #{w[:pid]} -> #{code}#{code >= 400 ? " #{data}" : ""}")
      else
        UI.message("#{w[:pid]} exists (#{sub['id']})")
      end
      next unless sub
      sub_id = sub["id"]

      code, locs = req.call(:get, "/v1/subscriptions/#{sub_id}/subscriptionLocalizations?limit=50")
      unless (locs["data"] || []).any? { |l| l.dig("attributes", "locale") == "en-US" }
        code, data = req.call(:post, "/v1/subscriptionLocalizations",
          { data: { type: "subscriptionLocalizations",
                    attributes: { locale: "en-US", name: w[:name], description: "Everything in Tenzy, unlimited. No ads." },
                    relationships: { subscription: { data: { type: "subscriptions", id: sub_id } } } } })
        UI.message("  localization -> #{code}")
      end

      # Availability: make it sellable in every territory (required before a price can be set).
      code, avail = req.call(:get, "/v1/subscriptions/#{sub_id}/subscriptionAvailability")
      has_avail = avail.is_a?(Hash) && avail["data"] && !avail["data"].nil?
      unless has_avail
        code, data = req.call(:post, "/v1/subscriptionAvailabilities",
          { data: { type: "subscriptionAvailabilities",
                    attributes: { availableInNewTerritories: true },
                    relationships: { subscription: { data: { type: "subscriptions", id: sub_id } },
                                     availableTerritories: { data: all_territories } } } })
        UI.message("  availability -> #{code}#{code >= 400 ? " #{data}" : ""}")
      end

      code, pp = req.call(:get, "/v1/subscriptions/#{sub_id}/pricePoints?filter%5Bterritory%5D=USA&limit=200")
      points = pp["data"] || []
      target = points.min_by { |p| (p.dig("attributes", "customerPrice").to_f - w[:usd].to_f).abs } if points.any?
      if target
        code, data = req.call(:post, "/v1/subscriptionPrices",
          { data: { type: "subscriptionPrices", attributes: { preserveCurrentPrice: false },
                    relationships: { subscription: { data: { type: "subscriptions", id: sub_id } },
                                     subscriptionPricePoint: { data: { type: "subscriptionPricePoints", id: target["id"] } } } } })
        UI.success("  price -> #{code} near $#{w[:usd]} (#{target.dig('attributes', 'customerPrice')})#{code >= 400 ? " #{data}" : ""}")
      else
        UI.important("  no USD price points returned (#{code})")
      end

      # Subscription App Review screenshot — REQUIRED so the IAP leaves "Missing Metadata" and is
      # reviewed WITH the app (fixes Apple 2.1(b): a Pro-referencing binary whose IAP wasn't
      # submitted). Always refreshed to the current paywall so it never shows a stale offer.
      shot = File.expand_path("review/paywall.png", __dir__)
      if File.exist?(shot)
        code, cur = req.call(:get, "/v1/subscriptions/#{sub_id}/appStoreReviewScreenshot")
        if cur.is_a?(Hash) && cur["data"]
          req.call(:delete, "/v1/subscriptionAppStoreReviewScreenshots/#{cur['data']['id']}")
          UI.message("  removed stale review screenshot; re-uploading current paywall")
        end
        bytes = File.binread(shot)
        code, resv = req.call(:post, "/v1/subscriptionAppStoreReviewScreenshots",
          { data: { type: "subscriptionAppStoreReviewScreenshots",
                    attributes: { fileName: "paywall.png", fileSize: bytes.bytesize },
                    relationships: { subscription: { data: { type: "subscriptions", id: sub_id } } } } })
        ss = resv.is_a?(Hash) ? resv["data"] : nil
        if ss
          (ss.dig("attributes", "uploadOperations") || []).each do |op|
            uri = URI(op["url"])
            h = Net::HTTP.new(uri.host, uri.port); h.use_ssl = (uri.scheme == "https")
            pr = Net::HTTP::Put.new(uri.request_uri)
            (op["requestHeaders"] || []).each { |hh| pr[hh["name"]] = hh["value"] }
            pr.body = bytes[op["offset"], op["length"]]
            h.request(pr)
          end
          require 'digest'
          code, _ = req.call(:patch, "/v1/subscriptionAppStoreReviewScreenshots/#{ss['id']}",
            { data: { type: "subscriptionAppStoreReviewScreenshots", id: ss["id"],
                      attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) } } })
          UI.success("  uploaded subscription review screenshot (#{code})")
        else
          UI.important("  could not reserve review screenshot: #{resv}")
        end
      end
    end
    UI.success("Subscriptions reconciled.")
  end

  # Public App Store submission. Pushes listing metadata (ios/fastlane/metadata) and screenshots
  # (ios/fastlane/screenshots) to the current editable version, attaches the latest TestFlight build,
  # and submits for review. The binary is NOT re-uploaded here (the beta lane already put it on
  # TestFlight) — this lane is metadata + submit only. Release is held for MANUAL release after
  # approval, so nothing goes public without a final tap. Idempotent: safe to re-run.
  #
  # Gated in CI behind a "Ship-Store=YES" commit marker + STORE_SUBMIT_ENABLED variable, exactly like
  # the TestFlight gate — so a normal push never submits for review.
  lane :release do
    key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"], in_house: false
    )

    deliver(
      api_key: key,
      app_identifier: "com.tenzy.toolkit",
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_binary_upload: true,          # binary already on TestFlight via :beta
      skip_app_version_update: false,
      overwrite_screenshots: true,
      # STAGE_ONLY=true pushes metadata + screenshots to the editable version but does NOT submit,
      # leaving the final "Add for Review" tap to Manan.
      submit_for_review: ENV["STAGE_ONLY"] != "true",
      automatic_release: false,          # hold for a manual "Release" tap after approval
      force: true,                       # non-interactive (no HTML preview prompt)
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        # HTTPS/standard crypto only — exempt from export compliance docs.
        export_compliance_uses_encryption: false,
        # App serves ads via AdMob and therefore uses the advertising identifier.
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_install: true,
        add_id_info_tracks_action: false,
        add_id_info_limits_tracking: true,
        content_rights_contains_third_party_content: false
      }
    )
    if ENV["STAGE_ONLY"] == "true"
      UI.success("Staged Tenzy metadata + screenshots on the editable version (NOT submitted — final tap is manual).")
    else
      UI.success("Submitted Tenzy to App Store review (held for manual release).")
    end
  end
end
