default_platform(:android)

# Tenzy Android lanes. The AAB upload to the Play "internal" track is handled in the GitHub
# workflow (r0adkll/upload-google-play). These lanes cover the STORE LISTING — title, descriptions,
# changelog and graphics — so the listing is pushed by the pipeline, not typed into the console by
# hand. Metadata lives in fastlane/metadata/android/en-US.
platform :android do
  # Push listing text + graphics (feature graphic, icon, phone screenshots) to Play. No binary.
  # Best-effort: the app must already exist in Play Console and have its one-time content
  # declarations (data safety, content rating) completed before Play accepts a listing push.
  lane :listing do
    supply(
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      # The app isn't published yet, so commit the listing as pending changes
      # instead of trying to send the whole app for review (which would fail).
      changes_not_sent_for_review: true
    )
  end

  # Upload the signed AAB. The app is still a DRAFT app, so Play rejects "completed" releases
  # (that is why the old r0adkll step with status:completed silently failed). Use a draft release
  # so the bundle actually lands in the library and can be promoted to a testing track.
  lane :upload do
    supply(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft",
      changes_not_sent_for_review: true
    )
  end
end
