<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal footprint: we only need window-state events to know which app is in front,
     plus retrieval of the clipboard when the user taps "copy". No keystroke logging. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewClicked|typeViewTextSelectionChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/clipboard_service_desc"
    android:notificationTimeout="100" />
